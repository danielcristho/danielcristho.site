{
  "name": "danielcristho.site",
  "type": "module",
  "version": "1.2.0",
  "author": "Daniel Pepuho",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint --ext .ts 'src/**/*.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "clean": "rm -rf dist .astro node_modules"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/partytown": "2.1.4",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/starlight": "^0.37.0",
    "@astrojs/tailwind": "6.0.2",
    "@astrojs/vercel": "^9.0.4",
    "astro": "^5.16.4",
    "astro-compress": "^2.2.7",
    "astro-robots-txt": "^1.0.0",
    "lucide-astro": "^0.309.0",
    "markdown-it": "^14.0.0",
    "sanitize-html": "^2.11.0",
    "sharp": "0.33.0",
    "starlight-blog": "^0.25.2",
    "starlight-giscus": "^0.8.1",
    "tailwindcss": "3.4.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^13.0.7",
    "@types/sanitize-html": "^2.9.5",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.1.0",
    "eslint-plugin-astro": "^1.6.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write"
    ],
    "*.astro": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
