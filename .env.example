# Umami Analytics Configuration
# Copy this file to .env and fill in your values

# Your Umami instance URL (without trailing slash)
PUBLIC_UMAMI_URL=https://your-umami.vercel.app

# Your website ID from Umami dashboard
PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here

# Umami admin credentials for API access
# Use the same username/password you use to login to Umami dashboard
UMAMI_USERNAME=admin
UMAMI_PASSWORD=your-umami-password
