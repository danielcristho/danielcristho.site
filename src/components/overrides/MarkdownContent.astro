---
const data = Astro.props?.data || {};
const cover = data.cover;
---

{cover && (
  <div style="margin-bottom: 1.5rem;">
    {cover.image && (
      <img
        src={cover.image}
        alt={cover.alt}
        class="sl-cover-image"
        style="width: 100%; border-radius: 12px;"
      />
    )}

    {cover.light && cover.dark && (
      <>
        <img src={cover.light} alt={cover.alt} class="light" style="width:100%;border-radius:12px;" />
        <img src={cover.dark} alt={cover.alt} class="dark" style="width:100%;border-radius:12px;" />
      </>
    )}
  </div>
)}