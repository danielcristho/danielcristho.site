---
import { getCollection } from "astro:content";

const { entry } = Astro.locals.starlightRoute;
const series = entry.data.series;
const parts = series
  ? (
      await getCollection(
        "docs",
        ({ data }) => data.series === series && !data.draft
      )
    ).sort((a, b) => +new Date(a.data.date!) - +new Date(b.data.date!))
  : [];
---

{
  parts.length > 1 && (
    <nav class="series-toc not-content" aria-label={`${series} series`}>
      <header class="series-head">
        <div>
          <div class="series-label">Series</div>
          <div class="series-name">{series}</div>
        </div>
        <div class="series-count">
          Part {parts.findIndex((p) => p.id === entry.id) + 1} of {parts.length}
        </div>
      </header>
      <ol class="series-list">
        {parts.map((part, i) => {
          const current = part.id === entry.id;
          return (
            <li class:list={["series-item", { current }]}>
              <span class="series-num">{i + 1}</span>
              {current ? (
                <span aria-current="page">{part.data.title}</span>
              ) : (
                <a href={`/${part.id}`}>{part.data.title}</a>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}

<style>
  .series-toc {
    margin: 1.5rem 0 2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    overflow: hidden;
  }
  .series-toc .series-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .series-toc .series-label {
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
  }
  .series-toc .series-name {
    font-size: var(--sl-text-lg);
    font-weight: 700;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .series-toc .series-count {
    flex: none;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .series-toc .series-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
  }
  .series-toc .series-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.375rem 1.25rem;
    font-size: var(--sl-text-sm);
    line-height: 1.4;
  }
  .series-toc .series-num {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1px solid var(--sl-color-gray-4);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .series-toc .series-item.current {
    font-weight: 700;
    color: var(--sl-color-white);
    background: var(--sl-color-accent-low);
  }
  .series-toc .series-item.current .series-num {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  .series-toc a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .series-toc a:hover {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
  }
</style>
