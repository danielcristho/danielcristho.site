---
import type { Props } from "@astrojs/starlight/props";
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { ANALYTICS } from "../contants";
// The font files are reached from inside the CSS bundle, so the browser only
// learns about them after it has parsed that CSS. Importing them here hands the
// same hashed URL to a preload hint, which starts both fetches at once.
import fontBody from "@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url";
import fontMono from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

const defaultOgImage = new URL("/og/default.png?v=2", Astro.site);

// Get cover image from frontmatter
const { entry } = Astro.locals.starlightRoute;
const cover = entry?.data?.cover;
const coverImage = cover?.image;

// Handle both string URLs and ImageMetadata objects
const ogImageSrc =
  typeof coverImage === "string" ? coverImage : coverImage?.src;

const ogImageUrl = ogImageSrc
  ? new URL(ogImageSrc, Astro.site)
  : defaultOgImage;
---

<DefaultHead {...Astro.props} />

<link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={fontMono} as="font" type="font/woff2" crossorigin />

<link
  rel="alternate"
  type="application/rss+xml"
  title="RSS Feed"
  href={new URL("rss.xml", Astro.site)}
/>

{/* Umami Analytics */}
{
  ANALYTICS.ENABLED && (
    <script
      async
      defer
      data-website-id={ANALYTICS.WEBSITE_ID}
      src={ANALYTICS.UMAMI_URL + "/script.js"}
    />
  )
}

{/* Social Meta Overrides */}
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:secure_url" content={ogImageUrl.href} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImageUrl.href} />
<meta name="author" content="Daniel Pepuho" />
