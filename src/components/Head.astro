---
import type { Props } from "@astrojs/starlight/props";
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { ANALYTICS } from "../contants";

const defaultOgImage = "/og/default.png?v=2";

// OG image URL
const isBlogPost = Astro.props.slug?.startsWith("blog/");
const ogImageUrl = isBlogPost
  ? new URL(`/og/${Astro.props.slug}.png?v=2`, Astro.site)
  : new URL(defaultOgImage, Astro.site);
---

<script is:inline>
  localStorage.setItem("starlight-theme", "light");
  document.documentElement.setAttribute("data-theme", "light");
</script>

<meta property="og:image" content={ogImageUrl} />
<meta property="twitter:image" content={ogImageUrl} />
<meta name="author" content="Daniel Pepuho" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="RSS Feed"
  href={new URL("rss.xml", Astro.site)}
/>

<!-- Umami Analytics -->
{
  ANALYTICS.ENABLED && (
    <script
      async
      defer
      data-website-id={ANALYTICS.WEBSITE_ID}
      src={ANALYTICS.UMAMI_URL + "/script.js"}
    />
  )
}

<DefaultHead {...Astro.props} />
