---
import type { Props } from "@astrojs/starlight/props";
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { ANALYTICS } from "../contants";

const defaultOgImage = new URL("/og/default.png?v=2", Astro.site);

// OG image URL, get cover from Cloudinary
const { entry } = Astro.props;
const coverImage = entry?.data?.cover?.image;

const ogImageUrl = coverImage
  ? new URL(coverImage, Astro.site)
  : defaultOgImage;
---

<script is:inline>
  localStorage.setItem("starlight-theme", "light");
  document.documentElement.setAttribute("data-theme", "light");
</script>

<meta property="og:image" content={ogImageUrl.href} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImageUrl.href} />
<meta name="author" content="Daniel Pepuho" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="RSS Feed"
  href={new URL("rss.xml", Astro.site)}
/>

<!-- Umami Analytics -->
{
  ANALYTICS.ENABLED && (
    <script
      async
      defer
      data-website-id={ANALYTICS.WEBSITE_ID}
      src={ANALYTICS.UMAMI_URL + "/script.js"}
    />
  )
}

<DefaultHead {...Astro.props} />
