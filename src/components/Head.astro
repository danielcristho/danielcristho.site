---
import type { Props } from "@astrojs/starlight/props";
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { ANALYTICS } from "../contants";

const defaultOgImage = new URL("/og/default.png?v=2", Astro.site);

// Get cover image from frontmatter
const { entry } = Astro.locals.starlightRoute;
const cover = entry?.data?.cover;
const coverImage = cover?.image;

// Handle both string URLs and ImageMetadata objects
const ogImageSrc =
  typeof coverImage === "string" ? coverImage : coverImage?.src;

const ogImageUrl = ogImageSrc
  ? new URL(ogImageSrc, Astro.site)
  : defaultOgImage;
---

<script is:inline>
  localStorage.setItem("starlight-theme", "light");
  document.documentElement.setAttribute("data-theme", "light");
</script>

<DefaultHead {...Astro.props} />

<link
  rel="alternate"
  type="application/rss+xml"
  title="RSS Feed"
  href={new URL("rss.xml", Astro.site)}
/>

{/* Umami Analytics */}
{
  ANALYTICS.ENABLED && (
    <script
      async
      defer
      data-website-id={ANALYTICS.WEBSITE_ID}
      src={ANALYTICS.UMAMI_URL + "/script.js"}
    />
  )
}

{/* Social Meta Overrides */}
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:secure_url" content={ogImageUrl.href} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImageUrl.href} />
<meta name="author" content="Daniel Pepuho" />
