<div id="giscuss-container" class="mt-8"></div>

<script>
    const script = document.createElement("script");
    const container = document.querySelector("#giscuss-container");

    let theme = "gruvbox_dark";

    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
        theme = localStorage.getItem("theme") ?? "dark";
    }

    Object.entries({
    src: "https://giscus.app/client.js",
        "data-repo": "danielcristho/danielcristho.site",
        "data-repo-id": "R_kgDOMo7Jhw",
        "data-category": "Announcements",
        "data-category-id": "DIC_kwDOMo7Jh84Cj76O",
        "data-mapping": "title",
        "data-strict": "0",
        "data-reactions-enabled": "1",
        "data-emit-metadata": "1",
        "data-input-position": "bottom",
        "data-theme": theme,
        "data-lang": "en",
        "data-loading": "lazy",
        crossorigin: "anonymous",
    }).forEach(([key, value]) => {
        script.setAttribute(key, value);
        });
    script.setAttribute("async", "true");

    container?.appendChild(script);
</script>