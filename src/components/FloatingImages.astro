---
// src/components/FloatingImages.astro
---

<div class="floating-images-container">
  <div class="floating-image image-1">
    <img
      src="https://res.cloudinary.com/diunivf9n/image/upload/v1766579087/morning_retro_nceycg.png"
      alt="Workspace"
      width="280"
      height="280"
      draggable="false"
      oncontextmenu="return false;"
      onselectstart="return false;"
      onmousedown="return false;"
    />
  </div>
  <div class="floating-image image-2">
    <img
      src="https://res.cloudinary.com/diunivf9n/image/upload/v1766579089/me_retro_gpsxct.png"
      alt="Portrait"
      width="280"
      height="280"
      draggable="false"
      oncontextmenu="return false;"
      onselectstart="return false;"
      onmousedown="return false;"
    />
  </div>
</div>

<style>
  .floating-images-container {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: -1; /* Behind content */
  }

  .floating-image {
    position: absolute;
    filter: grayscale(25%) blur(0.3px) brightness(1.04) contrast(1.03)
      sepia(0.12) hue-rotate(35deg);
    opacity: 0.75;
    border-radius: 0.8rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }

  /* on the night sky the prints are dimmer and carry a little of the page's
     olive, but they stay prints with edges */
  :global([data-theme="dark"]) .floating-image {
    filter: grayscale(45%) blur(0.3px) brightness(0.8) contrast(1.06) sepia(0.2)
      hue-rotate(35deg);
    opacity: 0.7;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
  }

  .floating-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.8rem;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
    -khtml-user-drag: none;
    -moz-user-drag: none;
    -o-user-drag: none;
    user-drag: none;
    pointer-events: none;
  }

  .image-1 {
    top: 18%;
    right: 28%;
    width: clamp(200px, 20vw, 280px);
    height: clamp(200px, 20vw, 280px);
    transform: rotate(15deg);
    animation: float1 8s ease-in-out infinite;
  }

  .image-2 {
    top: 50%;
    right: 32%;
    width: clamp(200px, 20vw, 280px);
    height: clamp(200px, 20vw, 280px);
    transform: rotate(15deg);
    animation: float2 10s ease-in-out infinite reverse;
  }

  @keyframes float1 {
    0%,
    100% {
      transform: rotate(15deg) translateY(0px);
    }
    50% {
      transform: rotate(15deg) translateY(-20px);
    }
  }

  @keyframes float2 {
    0%,
    100% {
      transform: rotate(15deg) translateY(0px);
    }
    50% {
      transform: rotate(15deg) translateY(20px);
    }
  }

  /* Hide on mobile and small tablets */
  @media (max-width: 1024px) {
    .floating-images-container {
      display: none;
    }
  }

  /* Adjust positioning for larger screens */
  @media (min-width: 1400px) {
    .image-1 {
      right: 25%;
      width: 320px;
      height: 320px;
    }

    .image-2 {
      right: 28%;
      width: 320px;
      height: 320px;
    }
  }

  /* Ultra-wide screen adjustments */
  @media (min-width: 1800px) {
    .image-1 {
      right: 20%;
    }

    .image-2 {
      right: 23%;
    }
  }
</style>
