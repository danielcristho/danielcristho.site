---
import { ANALYTICS } from "../contants";
---

{
  ANALYTICS.ENABLED && (
    <div class="realtime-widget">
      <div class="visitor-indicator">
        <span class="pulse-dot" />
        <span id="visitor-count">-</span> reading now
      </div>
    </div>
  )
}

<script>
  // Fetch real-time visitor count from Umami API
  async function updateVisitorCount() {
    try {
      // For now, show 0 since API routes aren't working with Starlight
      // In production, this would need server-side rendering
      const countElement = document.getElementById("visitor-count");
      if (countElement) {
        countElement.textContent = "0";
      }
    } catch (error) {
      console.log("Could not fetch visitor count");
    }
  }

  // Update every 30 seconds
  if (document.getElementById("visitor-count")) {
    updateVisitorCount();
    setInterval(updateVisitorCount, 30000);
  }
</script>

<style>
  .realtime-widget {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background: #f0f9ff;
    border: 1px solid #0ea5e9;
    border-radius: 20px;
    font-size: 0.875rem;
    color: #0369a1;
    margin: 1rem 0;
  }

  .visitor-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }

    70% {
      transform: scale(1);
      box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
    }

    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
  }
</style>
