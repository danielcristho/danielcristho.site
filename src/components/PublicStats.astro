---
import { ANALYTICS } from '../contants';

interface Props {
  shareUrl?: string;
  showRealtime?: boolean;
}

const { shareUrl, showRealtime = true } = Astro.props;
---

{ANALYTICS.ENABLED && shareUrl && (
  <div class="public-stats-container">
    <h3>Blog Analytics</h3>
    <iframe 
      src={shareUrl}
      width="100%" 
      height="400"
      frameborder="0"
      title="Public Analytics"
    ></iframe>
    
    {showRealtime && (
      <div class="realtime-stats">
        <p class="text-sm text-gray-600">
          Real-time visitors and page views
        </p>
      </div>
    )}
  </div>
)}

<style>
  .public-stats-container {
    margin: 2rem 0;
    padding: 1rem;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #f9fafb;
  }
  
  .public-stats-container h3 {
    margin-bottom: 1rem;
    color: #374151;
  }
  
  .realtime-stats {
    margin-top: 1rem;
    text-align: center;
  }
</style>