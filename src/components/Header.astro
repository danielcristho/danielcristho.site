---
import type { Props } from "@astrojs/starlight/props";

// import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
// import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
---

<div class="header">
  <div class="site-title">
    <SiteTitle {...Astro.props} />
  </div>
  
  <div class="center-group">
      <nav class="blog-links">
          <a href="/blog">Blog</a>
          <a href="https://docs.danielcristho.site">Docs</a>
      </nav>
      <Search {...Astro.props} />
  </div>
  <div class="right-group">
      <ThemeSelect {...Astro.props} />
      <!-- <LanguageSelect {...Astro.props} /> -->
  </div>
</div>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sl-nav-gap); 
    height: 100%;
    padding-inline: var(--sl-content-padding);
  }

  .site-title {
  }

  .center-group {
    display: flex;
    align-items: center;
    margin-left: auto; 
    margin-right: auto;
    gap: 1.5rem; 
  }

  .blog-links {
    display: flex;
    gap: 2rem; 
    border-inline-end: 1px solid var(--sl-color-gray-5);
    padding-inline-end: var(--sl-nav-gap);
  }

  .blog-links a {
    font-size: 130%;   /**Font size */
    color: #2e8555; /**Font colour */
  }

  .search-mobile {
    display: flex;
    align-items: center;
  }
  
  .right-group {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  @media (max-width: 50rem) {
    .header {
      justify-content: flex-start;
      gap: 1rem;
    }

    .center-group {
      display: flex;
      gap: 0.5rem;
      
      margin-left: 0.5rem;
      margin-right: 0;
    }
    
    .blog-links {
      border-inline-end: none;
      padding-inline-end: 0;
    }
  }

  .right-group > div:nth-child(1) select {
    text-indent: -9999px;
    margin-inline-end: 0.5rem; 
  }
  .right-group > div:nth-child(1) select {
    width: 2rem;
    height: 2rem;
    padding: 0;
  }
</style>