---
import type { Props } from "@astrojs/starlight/props";

import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
// import ThemeSelect from "./starlight/ThemeSelect.astro";
---

<div class="header">
  <div class="site-title">
    <SiteTitle {...Astro.props} />
  </div>
  
  <div class="center-group">
      <nav class="blog-links">
          <a 
            href="/blog"
            class="animated-underline"
            aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}
          >
            Blog
          </a>
          <a 
            href="https://docs.danielcristho.site"
            class="animated-underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Docs
          </a>
          <a 
            href="/about"
            class="animated-underline"
            aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}
          >
            About
          </a>
      </nav>
      <Search {...Astro.props} />
  </div>
  <!-- <div class="right-group">
      <ThemeSelect {...Astro.props} />
  </div> -->
</div>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sl-nav-gap); 
    height: 100%;
    padding-inline: var(--sl-content-padding);
  }

  .site-title {
  }

  .center-group {
    display: flex;
    align-items: center;
    margin-left: auto; 
    margin-right: auto;
    gap: 1.5rem; 
  }

  .blog-links {
    display: flex;
    gap: 2rem; 
    border-inline-end: 1px solid var(--sl-color-gray-5);
    padding-inline-end: var(--sl-nav-gap);
  }

  .blog-links a {
    font-size: 120%;   /**Font size */
    color: #2e8555 !important;
  }

  .search-mobile {
    display: flex;
    align-items: center;
  }
  
  .right-group {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  @media (max-width: 50rem) {
    .header {
      justify-content: flex-start;
      gap: 1rem;
    }

    .center-group {
      display: flex;
      gap: 0.5rem;
      
      margin-left: 0.5rem;
      margin-right: 0;
    }
    
    .blog-links {
      border-inline-end: none;
      padding-inline-end: 0;
    }
  }

  .right-group > div:nth-child(1) select {
    text-indent: -9999px;
    margin-inline-end: 0.5rem; 
  }
  .right-group > div:nth-child(1) select {
    width: 2rem;
    height: 2rem;
    padding: 0;
  }
</style>