---
import type { Props } from "@astrojs/starlight/props";

import { Icon } from "@astrojs/starlight/components";
import Search from "@astrojs/starlight/components/Search.astro";
import Logo from "./Logo.astro";
import SocialIcons from "./SocialIcons.astro";

const path = Astro.url.pathname;

const links = [
  { href: "/blog", label: "Blog" },
  { href: "/til", label: "TIL" },
  { href: "https://docs.danielcristho.site", label: "Docs", external: true },
  { href: "/about", label: "About" },
];
---

<div class="header">
  <Logo />

  <nav class="nav-right">
    {
      links.map(({ href, label, external }) => (
        <a
          href={href}
          class="nav-link"
          aria-current={!external && path.startsWith(href) ? "page" : undefined}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
        >
          {label}
        </a>
      ))
    }
    <Search {...Astro.props} />
    <div class="nav-icons">
      <SocialIcons {...Astro.props} />
    </div>
    <button
      type="button"
      class="theme-toggle"
      title="Toggle dark mode"
      aria-label="Toggle dark mode"
    >
      <Icon name="sun" class="icon-light" />
      <Icon name="moon" class="icon-dark" />
    </button>
  </nav>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
    padding-inline: var(--sl-content-padding);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-inline-start: auto;
  }

  .nav-link {
    color: inherit;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    opacity: 1;
  }

  .nav-icons {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .nav-icons :global(a) {
    color: inherit;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .nav-icons :global(a:hover) {
    color: inherit;
    opacity: 1;
    transform: none;
  }

  .nav-right :global(site-search button) {
    border: 0;
    padding: 0;
    background: none;
    box-shadow: none;
    color: inherit;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .nav-right :global(site-search button:hover) {
    opacity: 1;
  }

  .nav-right :global(site-search button > span),
  .nav-right :global(site-search button > kbd) {
    display: none;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .theme-toggle:hover {
    opacity: 1;
  }

  .theme-toggle .icon-dark,
  :global([data-theme="dark"]) .theme-toggle .icon-light {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle .icon-dark {
    display: block;
  }

  @media (max-width: 50rem) {
    .nav-right {
      gap: 0.9rem;
    }

    .nav-icons {
      display: none;
    }
  }
</style>

<script>
  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("starlight-theme", next);
    (window as any).StarlightThemeProvider?.updatePickers(next);
  });
</script>
