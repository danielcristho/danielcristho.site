---
import Default from "starlight-blog/overrides/MarkdownContent.astro";
import Giscus from "../Giscus.astro";
import ShareButtons from "../ShareButtons.astro";

const data = Astro.props?.data || {};
const cover = data.cover;

const isBlogPost = Astro.url.pathname.startsWith("/blog/");

const title = data.title || "";
const slug = data.slug || "";
const fullUrl = `https://danielcristho.site/${slug}`;
---

{cover && (
  <div style="margin-bottom: 1.5rem;">
    {cover.image && (
      <img src={cover.image} alt={cover.alt} style="width:100%;border-radius:12px;" />
    )}
  </div>
)}

<Default {...Astro.props}>
  <slot />
</Default>

{isBlogPost && (
  <>
    <div style="margin-top: 2rem;">
      <ShareButtons title={title} url={fullUrl} />
    </div>
    
    <div style="margin-top: 3rem;">
      <Giscus />
    </div>
  </>
)}
