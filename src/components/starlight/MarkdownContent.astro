---
import Default from "starlight-blog/overrides/MarkdownContent.astro";
import Giscus from "../Giscus.astro";
import ImageZoom from "starlight-image-zoom/components/ImageZoom.astro";

const isBlogPost = Astro.url.pathname.startsWith("/blog/");
---

<ImageZoom />

<Default {...Astro.props}>
  <slot />
</Default>

{
  isBlogPost && (
    <div style="margin-top: 3rem;">
      <Giscus />
    </div>
  )
}

<script>
  document
    .querySelectorAll(".sl-markdown-content img:not([loading])")
    .forEach((img) => {
      img.setAttribute("loading", "lazy");
      img.setAttribute("decoding", "async");
    });
</script>
