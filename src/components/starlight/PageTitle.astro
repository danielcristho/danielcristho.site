---
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/PageTitle.astro";
import PageViews from "../PageViews.astro";
import ShareButtons from "../ShareButtons.astro";

const { entry } = Astro.props;
const isBlogPost = Astro.url.pathname.startsWith("/blog/");

// Extract blog slug for analytics
const slug = entry?.slug || "";
const blogSlug = slug.replace("blog/", "");

// Get title and full URL for share buttons
const title = entry?.data?.title || "";
const fullUrl = Astro.url.href;
---

<Default {...Astro.props} />

{
  isBlogPost && (
    <>
      <div class="analytics-section">
        <PageViews slug={blogSlug} />
      </div>

      <div class="share-section">
        <ShareButtons title={title} url={fullUrl} />
      </div>
    </>
  )
}

<style>
  .analytics-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1rem 0;
    font-size: 0.9rem;
    color: #666;
  }

  .share-section {
    margin: 1rem 0 2rem 0;
  }

  .separator {
    opacity: 0.6;
  }

  /* Dark mode styling with requested color */
  :global([data-theme="dark"]) .analytics-section {
    color: #2e8555;
  }

  :global([data-theme="dark"]) .separator {
    color: #2e8555;
    opacity: 0.8;
  }
</style>
