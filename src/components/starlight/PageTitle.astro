---
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/PageTitle.astro";
import PageViews from "../PageViews.astro";
import ShareButtons from "../ShareButtons.astro";

const { entry } = Astro.props;
const isBlogPost = Astro.url.pathname.startsWith("/blog/");

// Extract blog slug reliably from the URL path for Astro v6
// Example: /blog/my-post/ -> ["blog", "my-post"] -> "my-post"
const pathParts = Astro.url.pathname.split("/").filter(Boolean);
const blogSlug = pathParts.length > 0 ? pathParts[pathParts.length - 1] : "";

console.log(
  `[PageTitle] Rendering for pathname: ${Astro.url.pathname}, slug: ${blogSlug}`
);

// Get title and full URL for share buttons
const title = entry?.data?.title || "";
const fullUrl = Astro.url.href;
---

<Default {...Astro.props} />

{
  isBlogPost && blogSlug && (
    <>
      <div class="analytics-section">
        <PageViews slug={blogSlug} />
      </div>

      <div class="share-section">
        <ShareButtons title={title} url={fullUrl} />
      </div>
    </>
  )
}

<style>
  .analytics-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1rem 0;
    font-size: 0.9rem;
    color: #666;
  }

  .share-section {
    margin: 1rem 0 2rem 0;
  }

  .separator {
    opacity: 0.6;
  }
</style>
