---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PageViews from '../PageViews.astro';
// import TotalReads from '../TotalReads.astro';

const { entry } = Astro.props;
const isBlogPost = Astro.url.pathname.startsWith("/blog/");

// Extract blog slug for analytics
const slug = entry?.slug || "";
const blogSlug = slug.replace('blog/', '');
---

<Default {...Astro.props} />

{isBlogPost && (
  <div class="analytics-section">
    <PageViews slug={blogSlug} /> 
    {/* <span class="separator">•</span> */}
    {/* <TotalReads slug={blogSlug} /> */}
  </div>
)}

<style>
  .analytics-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1rem 0 2rem 0;
    font-size: 0.9rem;
    color: #666;
  }

  .separator {
    opacity: 0.6;
  }

  /* Dark mode styling with requested color */
  :global([data-theme="dark"]) .analytics-section {
    color: #2e8555;
  }

  :global([data-theme="dark"]) .separator {
    color: #2e8555;
    opacity: 0.8;
  }
</style>