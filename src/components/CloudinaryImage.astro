---
interface Props {
  src: string;
  alt: string;
  width?: number;
  quality?: number;
  class?: string;
}

const { src, alt, width, quality = 80, class: className } = Astro.props;

const optimizeCloudinaryUrl = (url: string) => {
  if (!url.includes("res.cloudinary.com")) return url;
  const transforms = [
    "f_auto",
    `q_${quality}`,
    width ? `w_${width}` : "w_auto",
    "dpr_auto",
  ].join(",");
  return url.replace("/upload/", `/upload/${transforms}/`);
};

const optimizedSrc = optimizeCloudinaryUrl(src);
---

<img
  src={optimizedSrc}
  alt={alt}
  width={width}
  loading="lazy"
  decoding="async"
  class={className}
/>
