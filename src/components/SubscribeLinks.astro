---
// Subscribe links component for social platforms and RSS
---

<div class="subscribe-section">
  <div class="subscribe-links">
    <a
      href="https://medium.com/@danielpepuho"
      target="_blank"
      rel="noopener noreferrer"
      class="subscribe-link"
    >
      <svg
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        fill="currentColor"
      >
        <path
          d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"
        ></path>
      </svg>
      <span>Medium</span>
    </a>
    <a
      href="https://dev.to/danielcristho"
      target="_blank"
      rel="noopener noreferrer"
      class="subscribe-link"
    >
      <svg
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        fill="currentColor"
      >
        <path
          d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6l.02 2.44.04 2.45.56-.02c.41 0 .63-.07.83-.26.24-.24.26-.36.26-2.2 0-1.91-.02-1.96-.29-2.18zM0 4.94v14.12h24V4.94H0zM8.56 15.3c-.44.58-1.06.77-2.53.77H4.71V8.53h1.4c1.67 0 2.16.18 2.6.9.27.43.29.6.32 2.57.05 2.23-.02 2.73-.47 3.3zm5.09-5.47h-2.47v1.77h1.52v1.28l-.72.04-.75.03v1.77l1.22.03 1.2.04v1.28h-1.6c-1.53 0-1.6-.01-1.87-.3l-.3-.28v-3.16c0-3.02.01-3.18.25-3.48.23-.31.25-.31 1.88-.31h1.64v1.3zm4.68 5.45c-.17.43-.64.79-1 .79-.18 0-.45-.15-.67-.39-.32-.32-.45-.63-.82-2.08l-.9-3.39-.45-1.67h.76c.4 0 .75.02.75.05 0 .06 1.16 4.54 1.26 4.83.04.15.32-.7.73-2.3l.66-2.52.74-.04c.4-.02.73 0 .73.04 0 .14-1.67 6.38-1.8 6.68z"
        ></path>
      </svg>
      <span>Dev.to</span>
    </a>
    <a href="/blog/rss.xml" target="_blank" class="subscribe-link">
      <svg
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        fill="currentColor"
      >
        <path
          d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415c1.814 0 3.293 1.479 3.293 3.295 0 1.813-1.485 3.29-3.301 3.29C1.47 24 0 22.526 0 20.71s1.475-3.294 3.291-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z"
        ></path>
      </svg>
      <span>RSS</span>
    </a>
  </div>
</div>

<style>
  .subscribe-section {
    margin-top: 1rem;
    padding-top: 0.5rem;
  }

  .subscribe-label {
    font-size: clamp(0.875rem, 2vw, 1rem);
    margin-bottom: 0.75rem;
    color: var(--sl-color-text);
  }

  .subscribe-links {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .subscribe-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    background: rgba(46, 133, 85, 0.08);
    border: 1px solid rgba(46, 133, 85, 0.25);
    border-radius: 0.375rem;
    color: #2e8555;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .subscribe-link:hover {
    background: rgba(46, 133, 85, 0.15);
    border-color: rgba(46, 133, 85, 0.4);
    transform: translateY(-1px);
  }

  .subscribe-link svg {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }

  @media (prefers-color-scheme: dark) {
    .subscribe-link {
      background: rgba(74, 222, 128, 0.08);
      border-color: rgba(74, 222, 128, 0.25);
      color: #4ade80;
    }

    .subscribe-link:hover {
      background: rgba(74, 222, 128, 0.15);
      border-color: rgba(74, 222, 128, 0.4);
    }
  }

  @media (max-width: 640px) {
    .subscribe-links {
      gap: 0.5rem;
    }

    .subscribe-link {
      padding: 0.4rem 0.7rem;
    }
  }

  @media (min-width: 1025px) {
    .subscribe-links {
      justify-content: flex-start;
    }
  }
</style>
