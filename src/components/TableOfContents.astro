---
import Default from '@astrojs/starlight/components/TableOfContents.astro';

const isBlogIndexPage = Astro.props.entry?.slug === 'blog';
const isAnyTagPage = Astro.props.entry?.slug?.includes('blog/tags');
---

{
  isBlogIndexPage || isAnyTagPage ? (
    <style>
      .right-sidebar-container {
        display: none;
      }
    </style>
  ) : (
    <Default {...Astro.props}>
      <slot />
    </Default>
  )
}