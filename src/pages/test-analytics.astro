---
import RealtimeVisitors from "../components/RealtimeVisitors.astro";
import PageViews from "../components/PageViews.astro";
import PublicStats from "../components/PublicStats.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Analytics Test Page</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
        line-height: 1.6;
      }
      .test-section {
        margin: 2rem 0;
        padding: 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
      }
      h1,
      h2 {
        color: #333;
      }
    </style>
  </head>
  <body>
    <h1>Analytics Components Test</h1>

    <div class="test-section">
      <h2>Real-time Visitors</h2>
      <RealtimeVisitors />
    </div>

    <div class="test-section">
      <h2>Page Views (Test Slug)</h2>
      <PageViews slug="101-kubernetes-introduction" />
    </div>

    <div class="test-section">
      <h2>API Endpoints Test</h2>
      <button onclick="testVisitors()">Test Visitors API</button>
      <button onclick="testPageViews()">Test PageViews API</button>
      <div
        id="api-results"
        style="margin-top: 1rem; padding: 1rem; background: #f5f5f5; border-radius: 4px;"
      >
      </div>
    </div>

    <script>
      async function testVisitors() {
        const results = document.getElementById("api-results");
        results.innerHTML = "Testing visitors API...";

        try {
          const response = await fetch("/api/visitors");
          const data = await response.json();
          results.innerHTML = `<strong>Visitors API:</strong><br><pre>${JSON.stringify(data, null, 2)}</pre>`;
        } catch (error) {
          results.innerHTML = `<strong>Error:</strong> ${error.message}`;
        }
      }

      async function testPageViews() {
        const results = document.getElementById("api-results");
        results.innerHTML = "Testing pageviews API...";

        try {
          const response = await fetch(
            "/api/pageviews/101-kubernetes-introduction"
          );
          const data = await response.json();
          results.innerHTML = `<strong>PageViews API:</strong><br><pre>${JSON.stringify(data, null, 2)}</pre>`;
        } catch (error) {
          results.innerHTML = `<strong>Error:</strong> ${error.message}`;
        }
      }
    </script>
  </body>
</html>
